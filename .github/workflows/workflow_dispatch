name: Kleinanzeigen Bot Runner

on:
  schedule:
    - cron: '*/10 * * * *'
  workflow_dispatch:  # Dışarıdan tetiklenmeye izin verir

jobs:
  run-bot:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      # Bot çalışmadan ÖNCE geçmiş hafızayı geri yükler
      - name: Cache posted ads history
        uses: actions/cache@v3
        with:
          path: posted_ads.txt
          key: posted-ads-${{ github.run_id }}
          restore-keys: |
            posted-ads-

      - name: Run bot script
        env:
          DISCORD_WEBHOOK: ${{ secrets.DISCORD_WEBHOOK }}
          SCRAPER_API_KEY: ${{ secrets.SCRAPER_API_KEY }}
        run: python bot.py
